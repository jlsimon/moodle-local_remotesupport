{{!
    @template local_remotesupport/session_chat

    Teacher-facing, read-only chat transcript of a closed session — no
    JavaScript involved, the whole conversation is rendered server-side.

    Context variables required by this template:
    * heading, coursename, messages (sendername, message, time, isown),
      hasmessages, replayurl, historyurl
}}
<div class="local-remotesupport-session" role="status">
    <p class="local-remotesupport-session-bar">
        <strong>{{heading}}</strong><br>
        {{coursename}}
    </p>

    <div class="local-remotesupport-session-chat-full">
        {{^hasmessages}}
            <p>{{#str}}info_nochatmessages, local_remotesupport{{/str}}</p>
        {{/hasmessages}}
        {{#messages}}
            <div class="local-remotesupport-chat-message {{#isown}}local-remotesupport-chat-message-own{{/isown}}{{^isown}}local-remotesupport-chat-message-other{{/isown}}">
                <strong>{{sendername}}</strong> ({{time}}): {{message}}
            </div>
        {{/messages}}
    </div>

    <a class="btn btn-outline-secondary" href="{{{replayurl}}}">{{#str}}link_toreplay, local_remotesupport{{/str}}</a>
    <a class="btn btn-secondary" href="{{{historyurl}}}">{{#str}}link_backtohistory, local_remotesupport{{/str}}</a>
</div>

{{!
    @template local_remotesupport/teacher_settings

    Teacher's personal preferences for providing remote assistance.
    Currently a single checkbox; more parameters are expected to join it
    here later without needing a schema change (see teacher_settings.php).

    Context variables required by this template:
    * formurl, sesskey, supportenabled, backurl

    Example context (json):
    {
        "formurl": "https://example.com/local/remotesupport/teachersettings.php",
        "sesskey": "abcdef1234",
        "supportenabled": true,
        "backurl": "https://example.com/local/remotesupport/view.php"
    }
}}
<p><a href="{{{backurl}}}">{{#str}}link_backtorequests, local_remotesupport{{/str}}</a></p>
<form method="post" action="{{{formurl}}}" class="local-remotesupport-settingsform">
    <input type="hidden" name="action" value="save">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <div class="form-check">
        <input type="checkbox" class="form-check-input" id="local-remotesupport-supportenabled"
            name="supportenabled" value="1" {{#supportenabled}}checked{{/supportenabled}}>
        <label class="form-check-label" for="local-remotesupport-supportenabled">
            {{#str}}settings_supportenabled, local_remotesupport{{/str}}
        </label>
    </div>
    <button type="submit" class="btn btn-primary mt-3">{{#str}}button_savesettings, local_remotesupport{{/str}}</button>
</form>

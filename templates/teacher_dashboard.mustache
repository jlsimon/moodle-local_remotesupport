{{!
    @template local_remotesupport/teacher_dashboard

    Teacher-facing list of pending requests and open sessions.

    Context variables required by this template:
    * haspending, pending[] {studentname, coursename, waitingsince, reason, accepturl}
    * hasopen, open[] {studentname, coursename, status, enterurl, finishurl}
    * hassettings, settingsurl
    * hashistory, historyurl

    Example context (json):
    {
        "haspending": true,
        "pending": [
            {
                "studentname": "Jane Student",
                "coursename": "Course 101",
                "waitingsince": "2 minutes ago",
                "reason": "Stuck on question 3",
                "accepturl": "https://example.com/local/remotesupport/view.php?action=accept&sessionid=1&sesskey=abcdef1234"
            }
        ],
        "hasopen": false,
        "open": [],
        "hassettings": true,
        "settingsurl": "https://example.com/local/remotesupport/teachersettings.php",
        "hashistory": true,
        "historyurl": "https://example.com/local/remotesupport/sessionhistory.php"
    }
}}
{{#hassettings}}
<p class="text-right">
    <a href="{{{settingsurl}}}">{{#str}}link_mysettings, local_remotesupport{{/str}}</a>
</p>
{{/hassettings}}
{{#hashistory}}
<p class="text-right">
    <a href="{{{historyurl}}}">{{#str}}link_sessionhistory, local_remotesupport{{/str}}</a>
</p>
{{/hashistory}}
<h3>{{#str}}heading_pending, local_remotesupport{{/str}}</h3>
{{#haspending}}
<table class="generaltable local-remotesupport-pending">
    <thead>
        <tr>
            <th>{{#str}}col_student, local_remotesupport{{/str}}</th>
            <th>{{#str}}col_course, local_remotesupport{{/str}}</th>
            <th>{{#str}}col_waitingsince, local_remotesupport{{/str}}</th>
            <th>{{#str}}col_reason, local_remotesupport{{/str}}</th>
            <th>{{#str}}col_actions, local_remotesupport{{/str}}</th>
        </tr>
    </thead>
    <tbody>
    {{#pending}}
        <tr>
            <td>{{studentname}}</td>
            <td>{{coursename}}</td>
            <td>{{waitingsince}}</td>
            <td>{{reason}}</td>
            <td><a class="btn btn-primary btn-sm" href="{{{accepturl}}}">{{#str}}button_accept, local_remotesupport{{/str}}</a></td>
        </tr>
    {{/pending}}
    </tbody>
</table>
{{/haspending}}
{{^haspending}}
<p>{{#str}}nopending, local_remotesupport{{/str}}</p>
{{/haspending}}

<h3>{{#str}}heading_active, local_remotesupport{{/str}}</h3>
{{#hasopen}}
<table class="generaltable local-remotesupport-open">
    <thead>
        <tr>
            <th>{{#str}}col_student, local_remotesupport{{/str}}</th>
            <th>{{#str}}col_course, local_remotesupport{{/str}}</th>
            <th>{{#str}}col_status, local_remotesupport{{/str}}</th>
            <th>{{#str}}col_actions, local_remotesupport{{/str}}</th>
        </tr>
    </thead>
    <tbody>
    {{#open}}
        <tr>
            <td>{{studentname}}</td>
            <td>{{coursename}}</td>
            <td>{{status}}</td>
            <td>
                <a class="btn btn-primary btn-sm" href="{{{enterurl}}}">{{#str}}button_enter, local_remotesupport{{/str}}</a>
                <a class="btn btn-secondary btn-sm" href="{{{finishurl}}}">{{#str}}button_finish, local_remotesupport{{/str}}</a>
            </td>
        </tr>
    {{/open}}
    </tbody>
</table>
{{/hasopen}}
{{^hasopen}}
<p>{{#str}}noactive, local_remotesupport{{/str}}</p>
{{/hasopen}}

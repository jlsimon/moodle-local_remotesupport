{{!
    @template local_remotesupport/session_player

    Teacher-facing reconstruction view. The connection indicator and the
    sandboxed iframe itself are built by amd/src/event_player.js inside
    #local-remotesupport-player; this template only provides the static
    shell and the finish action.

    Context variables required by this template:
    * heading, finishurl

    Example context (json):
    {
        "heading": "Assisting Jane Student",
        "finishurl": "https://example.com/local/remotesupport/session.php?id=1&action=finish&sesskey=abcdef1234"
    }
}}
<div class="local-remotesupport-session" role="status">
    <p class="local-remotesupport-session-bar">
        <strong>{{heading}}</strong>
    </p>

    <div id="local-remotesupport-player" class="local-remotesupport-player"></div>

    <a class="btn btn-danger" href="{{{finishurl}}}">{{#str}}button_finish, local_remotesupport{{/str}}</a>
</div>

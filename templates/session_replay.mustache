{{!
    @template local_remotesupport/session_replay

    Teacher-facing session playback view. The playback controls, viewport
    and chat transcript are built by amd/src/session_replay.js inside
    #local-remotesupport-replayer; this template only provides the static
    shell and the "back to history" link.

    Context variables required by this template:
    * heading, coursename, sessiondate, historyurl
}}
<div class="local-remotesupport-session" role="status">
    <p class="local-remotesupport-session-bar">
        <strong>{{heading}}</strong><br>
        {{coursename}} — {{sessiondate}}
    </p>

    <div id="local-remotesupport-replayer" class="local-remotesupport-player"></div>

    <a class="btn btn-secondary" href="{{{historyurl}}}">{{#str}}link_backtohistory, local_remotesupport{{/str}}</a>
</div>
